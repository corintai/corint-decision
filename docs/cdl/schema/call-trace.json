{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Core call Trace v1",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "source",
      "resource_type",
      "resource_id",
      "call_path",
      "status",
      "score",
      "signal",
      "actions"
    ],
    "properties": {
      "source": {
        "type": "string"
      },
      "resource_type": {
        "enum": [
          "rule",
          "ruleset",
          "pipeline"
        ]
      },
      "resource_id": {
        "type": "string"
      },
      "call_path": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "status": {
        "enum": [
          "completed",
          "skipped"
        ]
      },
      "score": {
        "type": [
          "integer",
          "null"
        ]
      },
      "signal": {
        "enum": [
          "approve",
          "decline",
          "review",
          "hold",
          "pass",
          null
        ]
      },
      "actions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "if": {
      "properties": {
        "status": {
          "const": "skipped"
        }
      }
    },
    "then": {
      "properties": {
        "score": {
          "type": "null"
        },
        "signal": {
          "type": "null"
        },
        "actions": {
          "maxItems": 0
        }
      }
    }
  }
}
