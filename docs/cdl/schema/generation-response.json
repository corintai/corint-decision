{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Experimental CDL Core generation response",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "sources"],
  "properties": {
    "profile": {"const": "cdl-core-risk-draft-1"},
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "yaml"],
        "properties": {
          "path": {
            "type": "string", "maxLength": 256,
            "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*\\.ya?ml$"
          },
          "yaml": {"type": "string", "minLength": 1, "maxLength": 1048576}
        }
      }
    }
  }
}
