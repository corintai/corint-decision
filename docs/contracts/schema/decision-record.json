{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:corint:decision-record:1",
  "title": "decision-record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contract_version",
    "id",
    "revision",
    "provenance",
    "tenant_id",
    "decision_id",
    "business_event_id",
    "decided_at_ms",
    "subject",
    "engine_version",
    "input_evidence",
    "resources",
    "triggered_rules",
    "reasons",
    "result",
    "error_code",
    "duration_ms",
    "actions"
  ],
  "properties": {
    "kind": {
      "const": "corint-decision-record"
    },
    "contract_version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "reference"
      ],
      "properties": {
        "producer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "business_event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "decided_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_sha256",
        "context_sha256",
        "target_sha256",
        "bindings_sha256",
        "checker_sha256"
      ],
      "properties": {
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "context_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "target_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bindings_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checker_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "engine_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "input_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "sha256"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id",
          "revision",
          "sha256"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "feature",
              "model"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "triggered_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "result": {
      "type": "string",
      "enum": [
        "approve",
        "decline",
        "review",
        "no_match",
        "error",
        "hold",
        "pass"
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "idempotency_key",
          "type"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "repository_revision",
        "repository_manifest_sha256",
        "pipeline_id"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "repository_revision": {
          "type": "string",
          "minLength": 1
        },
        "repository_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pipeline_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
