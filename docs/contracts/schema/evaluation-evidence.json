{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:corint:evaluation-evidence:1",
  "title": "evaluation-evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contract_version",
    "id",
    "revision",
    "provenance",
    "subject",
    "scope",
    "dataset",
    "features",
    "samples",
    "result",
    "metrics",
    "created_at_ms"
  ],
  "properties": {
    "kind": {
      "const": "corint-evaluation-evidence"
    },
    "contract_version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "reference"
      ],
      "properties": {
        "producer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_sha256",
        "context_sha256",
        "target_sha256",
        "bindings_sha256",
        "checker_sha256"
      ],
      "properties": {
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "context_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "target_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bindings_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checker_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "scope": {
      "type": "string",
      "enum": [
        "behavior",
        "business"
      ]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "snapshot_sha256",
        "reference",
        "split_method",
        "train_partition_sha256",
        "tuning_partition_sha256",
        "evaluation_partition_sha256"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "synthetic",
            "real"
          ]
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "split_method": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "train_partition_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tuning_partition_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evaluation_partition_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id",
          "revision",
          "sha256"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "feature",
              "model"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature",
          "entity_id",
          "input_sha256",
          "offline_definition_sha256",
          "online_definition_sha256",
          "offline_value_sha256",
          "online_value_sha256",
          "event_time_ms",
          "available_time_ms",
          "decision_time_ms"
        ],
        "properties": {
          "feature": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id",
              "revision",
              "sha256"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "feature",
                  "model"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "entity_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "offline_definition_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "online_definition_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "offline_value_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "online_value_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "event_time_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "available_time_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "decision_time_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "result": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "unit"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "created_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
