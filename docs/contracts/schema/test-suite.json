{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Experimental offline CDL Core behavior suite (not CDL or an evaluation report)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "profile",
    "cases"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "profile": {
      "const": "cdl-core-risk-draft-1"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/definitions/case"
      }
    }
  },
  "definitions": {
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "score": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "signal": {
      "enum": [
        "approve",
        "decline",
        "review",
        "hold",
        "pass"
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "input"
      ],
      "oneOf": [
        {
          "required": [
            "expect"
          ],
          "not": {
            "required": [
              "expect_error"
            ]
          }
        },
        {
          "required": [
            "expect_error"
          ],
          "not": {
            "required": [
              "expect"
            ]
          }
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event"
          ],
          "properties": {
            "event": {
              "type": "object"
            }
          }
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pipeline_id",
            "score",
            "signal",
            "actions",
            "triggered_rules",
            "steps",
            "calls",
            "local_results"
          ],
          "properties": {
            "pipeline_id": {
              "type": "string"
            },
            "score": {
              "$ref": "#/definitions/score"
            },
            "signal": {
              "$ref": "#/definitions/signal"
            },
            "actions": {
              "$ref": "#/definitions/strings"
            },
            "triggered_rules": {
              "$ref": "#/definitions/strings"
            },
            "explanation": {
              "type": "string"
            },
            "steps": {
              "$ref": "#/definitions/strings"
            },
            "calls": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ruleset_id",
                  "rule_id",
                  "triggered",
                  "score"
                ],
                "properties": {
                  "ruleset_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "rule_id": {
                    "type": "string"
                  },
                  "triggered": {
                    "type": "boolean"
                  },
                  "score": {
                    "$ref": "#/definitions/score"
                  }
                }
              }
            },
            "local_results": {
              "type": "object",
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "score",
                      "signal"
                    ],
                    "properties": {
                      "score": {
                        "$ref": "#/definitions/score"
                      },
                      "signal": {
                        "$ref": "#/definitions/signal"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "score",
                      "matched"
                    ],
                    "properties": {
                      "score": {
                        "$ref": "#/definitions/score"
                      },
                      "matched": {
                        "type": "boolean"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status"
                    ],
                    "properties": {
                      "status": {
                        "const": "skipped"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "expect_error": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stage",
                "code"
              ],
              "properties": {
                "stage": {
                  "const": "input"
                },
                "code": {
                  "const": "E_INPUT_SCHEMA"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stage",
                "code"
              ],
              "properties": {
                "stage": {
                  "const": "execute"
                },
                "code": {
                  "enum": [
                    "E_NO_PIPELINE_MATCH",
                    "E_SCORE_OVERFLOW",
                    "E_MISSING_INPUT",
                    "E_RESULT_UNAVAILABLE",
                    "E_DIVISION_BY_ZERO",
                    "E_NUMBER_OVERFLOW",
                    "E_PIPELINE_SKIPPED"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  }
}
