{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BusinessContext v1 for CDL Core draft-1",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "contract_version", "id", "revision", "provenance", "input_schema", "entities", "fields", "objectives", "constraints", "actions"],
  "properties": {
    "kind": {"const": "corint-business-context"},
    "contract_version": {"const": "1"},
    "id": {"$ref": "#/definitions/text"}, "revision": {"$ref": "#/definitions/text"},
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["producer", "reference"],
      "properties": {"producer": {"$ref": "#/definitions/text"}, "reference": {"$ref": "#/definitions/text"}}
    },
    "input_schema": {"$ref": "urn:corint:core-input"},
    "entities": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/definitions/text"}},
    "fields": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["description", "unit", "entity", "time_basis"],
        "properties": {
          "description": {"$ref": "#/definitions/text"}, "unit": {"$ref": "#/definitions/text"},
          "entity": {"$ref": "#/definitions/text"}, "time_basis": {"$ref": "#/definitions/text"}
        }
      }
    },
    "objectives": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/text"}},
    "constraints": {"type": "array", "items": {"$ref": "#/definitions/text"}},
    "actions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/text"}}
  },
  "definitions": {"text": {"type": "string", "minLength": 1, "pattern": "\\S"}}
}
