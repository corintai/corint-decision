{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:corint:outcome-event:1",
  "title": "outcome-event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contract_version",
    "id",
    "revision",
    "provenance",
    "tenant_id",
    "decision_id",
    "business_event_id",
    "label_name",
    "label_version",
    "label",
    "occurred_at_ms",
    "observed_at_ms",
    "available_at_ms",
    "supersedes"
  ],
  "properties": {
    "kind": {
      "const": "corint-outcome-event"
    },
    "contract_version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "reference"
      ],
      "properties": {
        "producer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "business_event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "label_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "label_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "label": {
      "type": "string",
      "enum": [
        "positive",
        "negative",
        "unknown"
      ]
    },
    "occurred_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "observed_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "available_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  }
}
