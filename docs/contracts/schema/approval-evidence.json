{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:corint:approval-evidence:1",
  "title": "approval-evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contract_version",
    "id",
    "revision",
    "provenance",
    "subject",
    "evaluation_sha256",
    "approver",
    "decision",
    "issued_at_ms",
    "expires_at_ms"
  ],
  "properties": {
    "kind": {
      "const": "corint-approval-evidence"
    },
    "contract_version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "reference"
      ],
      "properties": {
        "producer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_sha256",
        "context_sha256",
        "target_sha256",
        "bindings_sha256",
        "checker_sha256"
      ],
      "properties": {
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "context_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "target_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bindings_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checker_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "evaluation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approver": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "issued_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
