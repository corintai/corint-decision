{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:corint:action-receipt:1",
  "title": "action-receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contract_version",
    "id",
    "revision",
    "provenance",
    "tenant_id",
    "decision_id",
    "business_event_id",
    "action_id",
    "idempotency_key",
    "status",
    "executed_at_ms",
    "detail"
  ],
  "properties": {
    "kind": {
      "const": "corint-action-receipt"
    },
    "contract_version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "reference"
      ],
      "properties": {
        "producer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "business_event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "manual_intervention"
      ]
    },
    "executed_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "detail": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
