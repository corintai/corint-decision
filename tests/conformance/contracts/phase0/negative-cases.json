      "pointer": "/resources",
      "value": [],
      "expected_code": "E_RESOURCE_BINDING"
    },
    {
      "id": "W04_not_deployed",
      "consumer": "resources",
      "base": "resource-bindings.json",
      "pointer": "/resources/1/status",
